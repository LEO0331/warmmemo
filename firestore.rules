rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTokenAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function hasAdminRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdminDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && hasAdminRole();
    }

    function isAdmin() {
      return isTokenAdmin() || isAdminDoc();
    }

    // Keep the checkout catalog in sync with packages_tab.dart.
    function checkoutPlanValid(order) {
      return (
        order.planName == '城市極簡告別'
        && order.priceAmount == 120000
        && order.priceLabel == 'NT$ 120,000'
      ) || (
        order.planName == '家庭溫馨告別'
        && order.priceAmount == 220000
        && order.priceLabel == 'NT$ 220,000'
      ) || (
        order.planName == '自然環保告別（樹葬／海葬）'
        && order.priceAmount == 150000
        && order.priceLabel == 'NT$ 150,000（不含政府規費）'
      ) || (
        order.planName == 'QR 紀念碑 / 數位追思牌'
        && order.priceAmount == 150000
        && order.priceLabel == 'NT$ 150,000'
      );
    }

    function ownerOrderCreateValid(userId) {
      let order = request.resource.data;
      return order.keys().hasOnly([
          'schemaVersion', 'planName', 'priceLabel', 'priceAmount', 'status',
          'createdAt', 'userId', 'companyName', 'contactNumber', 'agentName',
          'notes', 'paymentProvider', 'paymentStatus', 'invoiceId', 'checkoutUrl',
          'paymentCurrency', 'paidAt', 'paymentIntentId', 'verifiedBy',
          'verifiedAt', 'verificationNote', 'verificationLogs', 'proposal',
          'vendorAssignment', 'materialSelection', 'deliverySchedule'
        ])
        && order.userId == userId
        && order.schemaVersion is int
        && order.schemaVersion == 2
        && order.priceAmount is int
        && checkoutPlanValid(order)
        && order.createdAt is string
        && order.createdAt.size() > 0
        && order.createdAt.size() <= 40
        && order.status == 'pending'
        && order.paymentProvider == 'stripe'
        && order.paymentStatus == 'awaiting_checkout'
        && order.paymentCurrency == 'twd'
        && order.get('companyName', null) == null
        && order.get('contactNumber', null) == null
        && order.get('agentName', null) == null
        && order.get('notes', null) == null
        && order.get('invoiceId', null) == null
        && order.get('checkoutUrl', null) == null
        && order.get('paidAt', null) == null
        && order.get('paymentIntentId', null) == null
        && order.get('verifiedBy', null) == null
        && order.get('verifiedAt', null) == null
        && order.get('verificationNote', null) == null
        && order.get('verificationLogs', []) == []
        && order.get('proposal', null) == null
        && order.get('vendorAssignment', null) == null
        && order.get('materialSelection', null) == null
        && order.get('deliverySchedule', []) == [];
    }

    function ownerOrderCheckoutUpdateValid(orderId) {
      let order = request.resource.data;
      return order.diff(resource.data).affectedKeys().hasOnly([
          'paymentProvider', 'paymentStatus', 'invoiceId', 'checkoutUrl', 'paymentCurrency'
        ])
        && resource.data.get('status', null) != 'complete'
        && resource.data.get('paymentStatus', null) in [
          'awaiting_checkout', 'failed', 'cancelled', 'expired'
        ]
        && orderId.matches('^[A-Za-z0-9_-]{1,200}$')
        && order.paymentStatus == 'checkout_created'
        && order.paymentProvider == 'stripe'
        && order.paymentCurrency == 'twd'
        && order.invoiceId == 'hosted_' + orderId
        && order.checkoutUrl is string
        && order.checkoutUrl.size() <= 2048
        && order.checkoutUrl.matches('^https://buy[.]stripe[.]com/[^?#]+([?][^#]*)?(#.*)?$');
    }

    function ownerOrderProposalUpdateValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposal'])
        && ownerOrderProposalShapeValid();
    }

    function ownerOrderProposalShapeValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['proposal'])
        || (
          request.resource.data.get('proposal', null) == null
          || (
            request.resource.data.proposal is map
            && request.resource.data.proposal.keys().hasOnly([
              'vendorPreference',
              'materialChoice',
              'schedulePreference',
              'note',
              'submittedAt'
            ])
            && (
              !('vendorPreference' in request.resource.data.proposal)
              || request.resource.data.proposal.vendorPreference is string
              || request.resource.data.proposal.vendorPreference == null
            )
            && (
              !('materialChoice' in request.resource.data.proposal)
              || request.resource.data.proposal.materialChoice is string
              || request.resource.data.proposal.materialChoice == null
            )
            && (
              !('schedulePreference' in request.resource.data.proposal)
              || request.resource.data.proposal.schedulePreference is string
              || request.resource.data.proposal.schedulePreference == null
            )
            && (
              !('note' in request.resource.data.proposal)
              || request.resource.data.proposal.note is string
              || request.resource.data.proposal.note == null
            )
            && (
              !('submittedAt' in request.resource.data.proposal)
              || request.resource.data.proposal.submittedAt is string
              || request.resource.data.proposal.submittedAt == null
            )
          )
        );
    }

    function orderSchemaValid() {
      return request.resource.data.priceAmount is int
        && request.resource.data.priceAmount >= 0
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 1;
    }

    function caseTransitionValid() {
      let before = resource.data.get('status', null);
      let after = request.resource.data.get('status', null);
      let fromStatus = before == null ? 'pending' : before;
      let toStatus = after == null ? 'pending' : after;
      return toStatus == fromStatus
        || (fromStatus == 'pending' && toStatus == 'received')
        || (fromStatus == 'received' && toStatus == 'complete');
    }

    function paymentTransitionValid() {
      let before = resource.data.get('paymentStatus', null);
      let after = request.resource.data.get('paymentStatus', null);
      let fromPayment = before == null ? 'checkout_created' : before;
      let toPayment = after == null ? 'checkout_created' : after;
      return toPayment == fromPayment
        || (fromPayment == 'awaiting_checkout' && toPayment in ['checkout_created', 'cancelled', 'expired'])
        || (fromPayment == 'checkout_created' && toPayment in ['paid', 'failed', 'cancelled', 'expired'])
        || (fromPayment in ['failed', 'cancelled', 'expired'] && toPayment == 'checkout_created');
    }

    function completeRequiresPaid() {
      return request.resource.data.get('status', null) != 'complete'
        || request.resource.data.get('paymentStatus', null) == 'paid';
    }

    function adminOrderUpdateValid() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() && orderSchemaValid()
        && (
          changed.hasOnly(['schemaVersion', 'priceAmount'])
          || (caseTransitionValid() && paymentTransitionValid() && completeRequiresPaid())
        );
    }

    function ownerUserSafeUpdate(userId) {
      return isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'tokenBalance',
          'tokenGrantedAt',
          'tokenUpdatedAt'
        ]);
    }

    function ownerTokenConsumeUpdate(userId) {
      return isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'tokenBalance',
          'tokenUpdatedAt'
        ])
        && request.resource.data.tokenBalance is int
        && resource.data.tokenBalance is int
        && request.resource.data.tokenBalance == resource.data.tokenBalance - 1
        && request.resource.data.tokenBalance >= 0;
    }

    function ownerTokenBootstrapUpdate(userId) {
      return isOwner(userId)
        && !(resource.data.tokenBalance is int)
        && request.resource.data.tokenBalance == 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'updatedAt',
          'role',
          'tokenBalance',
          'tokenGrantedAt',
          'tokenUpdatedAt'
        ])
        && (
          (resource.data.role is string && request.resource.data.role == resource.data.role)
          || (!(resource.data.role is string) && request.resource.data.role == 'user')
        );
    }

    function cyberSkillVersionValid(v) {
      return v is string && v.matches('^v[0-9]{6}$');
    }

    function cyberSkillSourceStatsValid(summary) {
      return !('sourceStats' in summary)
        || (
          summary.sourceStats is map
          && summary.sourceStats.keys().hasOnly(['messages', 'documents', 'emails'])
          && (!('messages' in summary.sourceStats) || summary.sourceStats.messages is int)
          && (!('documents' in summary.sourceStats) || summary.sourceStats.documents is int)
          && (!('emails' in summary.sourceStats) || summary.sourceStats.emails is int)
        );
    }

    function cyberSkillSummaryValid(summary) {
      return summary is map
        && summary.keys().hasOnly([
          'toneTraits',
          'decisionPriorities',
          'workMethods',
          'boundaries',
          'sourceStats'
        ])
        && (!('toneTraits' in summary) || (summary.toneTraits is list && summary.toneTraits.size() <= 10))
        && (!('decisionPriorities' in summary) || (summary.decisionPriorities is list && summary.decisionPriorities.size() <= 10))
        && (!('workMethods' in summary) || (summary.workMethods is list && summary.workMethods.size() <= 10))
        && (!('boundaries' in summary) || (summary.boundaries is list && summary.boundaries.size() <= 10))
        && cyberSkillSourceStatsValid(summary);
    }

    function cyberSkillCommonValid() {
      return request.resource.data.keys().hasOnly([
          'templateType',
          'profileName',
          'profileIdentity',
          'analysisSummary',
          'markdown',
          'version',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.templateType in ['warmmemoDaily', 'colleagueWork']
        && request.resource.data.profileName is string
        && request.resource.data.profileName.size() > 0
        && request.resource.data.profileName.size() <= 80
        && request.resource.data.profileIdentity is string
        && request.resource.data.profileIdentity.size() <= 160
        && cyberSkillSummaryValid(request.resource.data.analysisSummary)
        && request.resource.data.markdown is string
        && request.resource.data.markdown.size() > 0
        && request.resource.data.markdown.size() <= 20000
        && cyberSkillVersionValid(request.resource.data.version)
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.tokenBalance == 5;
      allow update: if ownerUserSafeUpdate(userId)
        || ownerTokenBootstrapUpdate(userId)
        || ownerTokenConsumeUpdate(userId)
        || isAdmin();
      allow delete: if isAdmin();

      match /drafts/{draftId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /meta/{metaDoc} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /orders/{orderId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && ownerOrderCreateValid(userId);
        allow update: if (isOwner(userId)
            && (ownerOrderProposalUpdateValid() || ownerOrderCheckoutUpdateValid(orderId)))
          || adminOrderUpdateValid();
        allow delete: if isAdmin();
      }

      match /tokenLogs/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId)
            && request.resource.data.type == 'consume'
            && request.resource.data.cost == 1)
          || isAdmin();
        allow update, delete: if isAdmin();
      }

      match /cyberSkills/{skillId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin())
          && cyberSkillCommonValid()
          && request.resource.data.version == 'v000001';
        allow update: if (isOwner(userId) || isAdmin())
          && cyberSkillCommonValid()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.version > resource.data.version;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /topupRequests/{requestId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedTokens is int
          && request.resource.data.requestedTokens > 0
          && request.resource.data.requestedTokens <= 1000;
        allow update, delete: if isAdmin();
      }
    }

    // Admin-only catch-all for any orders subcollection path.
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }

    // Backward compatible: root-level orders/{orderId}
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isSignedIn()
        && ownerOrderCreateValid(request.auth.uid);
      allow update: if (isSignedIn()
          && request.auth.uid == resource.data.userId
          && (ownerOrderProposalUpdateValid() || ownerOrderCheckoutUpdateValid(orderId)))
        || (adminOrderUpdateValid()
          && request.resource.data.get('userId', null) == resource.data.get('userId', null));
      allow delete: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == request.resource.data.userId);
      allow update: if isAdmin()
        || (isSignedIn()
          && request.auth.uid == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt'])
          && request.resource.data.status == 'read');
      allow delete: if isAdmin();
    }

    match /public_memorials/{slug} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && (request.auth.uid == request.resource.data.ownerUid || isAdmin());
      allow update: if isSignedIn()
        && (
          isAdmin()
          || (
            request.auth.uid == resource.data.ownerUid
            && request.auth.uid == request.resource.data.ownerUid
          )
        );
      allow delete: if isSignedIn()
        && (isAdmin() || request.auth.uid == resource.data.ownerUid);
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow create: if isOwner(adminId) && hasAdminRole();
      allow update, delete: if isTokenAdmin();
    }
  }
}
